@page
@model ProiectMedii1.Pages.Experiences.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Experience[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Experience[0].Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Experience[0].EventDateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Experience[0].Duration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Experience[0].Member)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Experience[0].Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Experience) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EventDateTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Duration)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Member.FullName)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
